# Copy to .env and fill in real values. .env is git-ignored — never commit it.
# See ../AGENTS.md for the constraints on this deployment.

# ---- Dedicated PostgreSQL for Keycloak (do NOT reuse the AG-Flow app DB) ----
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=changeme-strong-password

# ---- Keycloak bootstrap admin (used only to create the initial admin) ----
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=changeme-strong-password
